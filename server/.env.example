# From your Neon project dashboard -> Connection Details.
#
# DATABASE_URL: the POOLED connection string (hostname has "-pooler" in it).
# The app uses this at runtime. Pooling matters a lot when this runs as
# Vercel serverless functions, since many short-lived invocations can open
# connections concurrently and Postgres has a hard connection limit.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/pacefm_finance?sslmode=require&pgbouncer=true&connection_limit=1

# DIRECT_URL: the DIRECT (non-pooled) connection string, no "-pooler".
# Prisma Migrate needs this one — migrations use session-level features
# (advisory locks) that don't work through a transaction-mode pooler.
DIRECT_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/pacefm_finance?sslmode=require

JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development

# Egyptian Tax Authority (ETA) e-invoicing integration.
#
# ETA_ENV selects which ETA environment to talk to: "preprod" (sandbox,
# default) or "production". Use preprod until the integration has been
# verified end-to-end.
#
# ETA_CLIENT_ID / ETA_CLIENT_SECRET come from ETA's "Add ERP System"
# registration on their developer portal. Treat these like passwords —
# never commit real values. In production these are set directly as
# Vercel environment variables on the API project, not in this file.
ETA_ENV=preprod
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=

# Optional overrides, only needed if ETA's documented endpoints change or
# you need to point at a non-default URL. Leave unset to use the built-in
# defaults for the selected ETA_ENV.
# ETA_TOKEN_URL=
# ETA_API_BASE_URL=
