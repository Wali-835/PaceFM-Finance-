# From your Neon project dashboard -> Connection Details.
#
# DATABASE_URL: the POOLED connection string (hostname has "-pooler" in it).
# The app uses this at runtime. Pooling matters a lot when this runs as
# Vercel serverless functions, since many short-lived invocations can open
# connections concurrently and Postgres has a hard connection limit.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/pacefm_finance?sslmode=require&pgbouncer=true&connection_limit=1

# DIRECT_URL: the DIRECT (non-pooled) connection string, no "-pooler".
# Prisma Migrate needs this one — migrations use session-level features
# (advisory locks) that don't work through a transaction-mode pooler.
DIRECT_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/pacefm_finance?sslmode=require

JWT_SECRET=change-this-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
